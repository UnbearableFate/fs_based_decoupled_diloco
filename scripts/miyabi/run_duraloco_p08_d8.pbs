#!/bin/bash
#PBS -N duraloco_p08r_d8
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=8:mpiprocs=1
#PBS -l walltime=00:25:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
: "${EXPECTED_COMMIT:?}" "${RUN_ID:?}" "${ARTIFACT_ROOT:?}" "${STORAGE_ROOT:?}"
PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
CONFIG="$PROJECT_ROOT/configs/duraloco_milestone_gpt2_8node_50x10.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"
TRAIN_RUN="$RUN_ID-training"
cd "$PROJECT_ROOT"
if ! mkdir "$STORAGE_ROOT"; then
  echo "refusing reused P08 storage root: $STORAGE_ROOT" >&2
  exit 2
fi
if ! mkdir "$ARTIFACT_ROOT"; then
  echo "refusing reused P08 artifact root: $ARTIFACT_ROOT" >&2
  exit 2
fi
mkdir "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
result=fail; exit_code=1; started=$(date +%s)

finish() {
  observed=$?
  [[ "$result" == pass ]] && exit_code=0 || { [[ "$observed" -eq 0 ]] || exit_code=$observed; }
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(--root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" --phase P08R
    --purpose experiment --run-id "$RUN_ID" --schema-version 2
    --validation-shape p08r-d8-factor-one-eight-node-gpt2-wikitext2-50x10
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1
    --config scripts/miyabi/run_duraloco_p08_d8.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue regular-g --requested-resources select=8:mpiprocs=1,walltime=00:25:00
    --last-qstat-state R --termination-detail "P08 D8 factor-one optimized GPT-2/WikiText-2 50x10 raw profile"
    --assertion "the eight-node allocation contains eight learner-hosted LFEs and zero dedicated syncer or idle control nodes"
    --assertion "ten single-head transitions and ten complete causal work-order timelines pass"
    --assertion "direct fragment I/O, streaming reduction, strict validation, and raw GPU-step evidence remain enabled")
  [[ -f "$ARTIFACT_ROOT/p08_d8_report.json" ]] && args+=(--stage-metrics-path p08_d8_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P08 D8 failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1 --untracked-files=no)" ]]
mapfile -t ALL_HOSTS < <(sort -u "$PBS_NODEFILE")
[[ "${#ALL_HOSTS[@]}" -eq 8 ]]
LEARNER_HOSTS=("${ALL_HOSTS[@]}")
printf '%s\n' "${ALL_HOSTS[@]}" | tee "$ARTIFACT_ROOT/hosts.log"
printf '%s\n' "${LEARNER_HOSTS[@]}" > "$ARTIFACT_ROOT/learner_hosts.log"
NODE_IDS=$(IFS=,; echo "${LEARNER_HOSTS[*]}")
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
findmnt -T "$TRAINING_ROOT" > "$ARTIFACT_ROOT/mount.log" 2>&1 || true
lfs getstripe "$TRAINING_ROOT" > "$ARTIFACT_ROOT/stripe.log" 2>&1 || true
"$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" \
  --output "$ARTIFACT_ROOT/forbidden_surface.json"

command=(mpirun --bind-to none -np 8 --hostfile "$ARTIFACT_ROOT/learner_hosts.log"
  /usr/bin/env PROJECT_ROOT="$PROJECT_ROOT" PYTHON_BIN="$PYTHON_BIN" CONFIG="$CONFIG"
  RUN_ID="$TRAIN_RUN" SHARED_ROOT="$TRAINING_ROOT" ARTIFACT_ROOT="$ARTIFACT_ROOT"
  NODE_IDS="$NODE_IDS" PYTHONPATH="$PROJECT_ROOT" WANDB_MODE=disabled
  bash scripts/miyabi/run_p08_d8_factor_one_host.sh)
printf '%q ' "${command[@]}" | tee "$ARTIFACT_ROOT/commands.log"; printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${command[@]}" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"

"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json \
  | tee "$ARTIFACT_ROOT/training_summary.json"
elapsed=$(($(date +%s) - started))
"$PYTHON_BIN" scripts/agent/create_p06b_d8_report.py --root "$TRAINING_ROOT" \
  --artifacts "$ARTIFACT_ROOT" --run-id "$TRAIN_RUN" --elapsed-seconds "$elapsed" \
  --max-elapsed-seconds 1500 \
  --output "$ARTIFACT_ROOT/factor_one_base_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p08_performance_report.py factor-one \
  --root "$TRAINING_ROOT" --artifacts "$ARTIFACT_ROOT" --run-id "$TRAIN_RUN" \
  --config "$CONFIG" --elapsed-seconds "$elapsed" \
  --base-report "$ARTIFACT_ROOT/factor_one_base_report.json" \
  --output "$ARTIFACT_ROOT/p08_d8_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
result=pass; exit_code=0
