#!/bin/bash
#PBS -N duraloco_p06a_unit
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] P06A unit gate failed at line $LINENO" >&2' ERR

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
ARCHIVE_CHECKOUT="${TMPDIR:?TMPDIR is required}/duraloco-p06-archive"
cleanup() {
  git worktree remove --force "$ARCHIVE_CHECKOUT" >/dev/null 2>&1 || true
}
trap cleanup EXIT

[[ "$(hostname)" == mg* ]]
[[ -n "${PBS_JOBID:-}" && -n "${PBS_NODEFILE:-}" ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]

hostname | tee "$ARTIFACT_ROOT/hostname.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
git worktree add --detach "$ARCHIVE_CHECKOUT" \
  06e3ca2299d5eb1a720c1d8f9107af5223095525 \
  > "$ARTIFACT_ROOT/archive_checkout.log" 2>&1

run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
}

set +e
run_command "$PYTHON_BIN" scripts/agent/create_p06a_characterization.py \
  --archive-root "$ARCHIVE_CHECKOUT" --output "$ARTIFACT_ROOT/oracle_trace.json"
characterization_status=$?
if (( characterization_status == 0 )); then
  run_command "$PYTHON_BIN" -m pytest -q \
    tests/syncer_decomposition \
    tests/test_proposal_catalog.py \
    tests/test_outer_optim.py \
    tests/coordination \
    tests/log/test_production_runtime.py \
    tests/test_retention.py \
    tests/test_removed_config_keys.py \
    --junitxml "$ARTIFACT_ROOT/junit.xml"
  test_status=$?
else
  test_status=$characterization_status
fi
set -e

qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
manifest_args=(
  --root "$PROJECT_ROOT"
  --output "$ARTIFACT_ROOT/manifest.json"
  --phase P06A
  --purpose unit
  --run-id "$RUN_ID"
  --schema-version 2
  --validation-shape p06a-characterization-kernel-schema-capability-1node
  --config scripts/miyabi/run_duraloco_p06a_unit_1node.pbs
  --backend memory
  --commands-log commands.log
  --stdout stdout.log
  --stderr stderr.log
  --exit-code "$test_status"
  --pbs-queue debug-g
  --requested-resources select=1:mpiprocs=1,walltime=00:10:00
  --last-qstat-state R
  --termination-detail "P06A archive characterization and decomposed CRS focused gate"
  --assertion "archive inline and decomposed kernels have exact aggregate, parameter, and outer-state bytes"
  --assertion "pure planning/numeric kernels and prepare-only capability surface pass"
  --assertion "inactive FWO/PFT schemas reject unknown, null, and conflicting identity content"
)
if [[ -n "$PARENT_RUN_ID" ]]; then
  manifest_args+=(--parent-run-id "$PARENT_RUN_ID")
fi
if (( test_status == 0 )); then
  manifest_args+=(--result pass --termination-kind success)
else
  manifest_args+=(--result fail --termination-kind test_failure)
fi
"$PYTHON_BIN" scripts/agent/create_run_manifest.py "${manifest_args[@]}"
"$PYTHON_BIN" scripts/agent/check_run_manifest.py "$ARTIFACT_ROOT/manifest.json" \
  --root "$PROJECT_ROOT"
exit "$test_status"
