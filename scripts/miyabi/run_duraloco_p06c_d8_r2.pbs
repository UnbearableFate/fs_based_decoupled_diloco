#!/bin/bash
#PBS -N duraloco_p06c_d8
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=8:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${STORAGE_ROOT:?STORAGE_ROOT is required}"
: "${FACTOR_ONE_REPORT:?FACTOR_ONE_REPORT is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/duraloco_milestone_gpt2_9node_50x10.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"
TRAIN_RUN="$RUN_ID-training"
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT" "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
started=$(date +%s)
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json"
    --phase P06C --purpose experiment --run-id "$RUN_ID" --schema-version 2
    --validation-shape p06c-d8-r2-hedged-gpt2-wikitext2-50x10-chaos
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1
    --config scripts/miyabi/run_duraloco_p06c_d8_r2.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue regular-g --requested-resources select=8:mpiprocs=1,walltime=00:20:00
    --last-qstat-state R --termination-detail "P06C D8-R2 hedged GPT-2/WikiText-2 50x10 with executor and whole learner-host chaos"
    --assertion "eight learner nodes, eight LFEs, factor-two ownership, and zero dedicated syncer nodes"
    --assertion "fixed 6000 ms hedged policy survives primary executor and whole learner-host plus committer loss"
    --assertion "committed membership revision one, strict replay, resource/latency telemetry, and factor-one comparison pass"
  )
  if [[ -n "$PARENT_RUN_ID" ]]; then args+=(--parent-run-id "$PARENT_RUN_ID"); fi
  [[ -f "$ARTIFACT_ROOT/d8_r2_report.json" ]] && args+=(--stage-metrics-path d8_r2_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06C D8-R2 failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
[[ "$STORAGE_ROOT" == "$PROJECT_ROOT"/* ]]
[[ -f "$FACTOR_ONE_REPORT" ]]
mapfile -t HOSTS < <(sort -u "$PBS_NODEFILE")
[[ "${#HOSTS[@]}" -eq 8 ]]
NODE_IDS=$(IFS=,; echo "${HOSTS[*]}")
printf '%s\n' "${HOSTS[@]}" | tee "$ARTIFACT_ROOT/hosts.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
"$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"

command=(mpirun --bind-to none -np 8 --hostfile "$PBS_NODEFILE" /usr/bin/env PROJECT_ROOT="$PROJECT_ROOT" PYTHON_BIN="$PYTHON_BIN" CONFIG="$CONFIG" RUN_ID="$TRAIN_RUN" SHARED_ROOT="$TRAINING_ROOT" ARTIFACT_ROOT="$ARTIFACT_ROOT" NODE_IDS="$NODE_IDS" PYTHONPATH="$PROJECT_ROOT" bash scripts/miyabi/run_p06c_d8_r2_host.sh)
printf '%q ' "${command[@]}" | tee "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${command[@]}" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"

"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json | tee "$ARTIFACT_ROOT/training_summary.json"
elapsed=$(($(date +%s) - started))
"$PYTHON_BIN" scripts/agent/create_p06c_runtime_report.py --root "$TRAINING_ROOT" --run-id "$TRAIN_RUN" --run-generation 0 --expected-mode hedged --expected-learners 8 --allow-degraded-attempts --output "$ARTIFACT_ROOT/d8_r2_runtime_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p06c_d8_report.py --root "$TRAINING_ROOT" --artifacts "$ARTIFACT_ROOT" --run-id "$TRAIN_RUN" --elapsed-seconds "$elapsed" --runtime-report "$ARTIFACT_ROOT/d8_r2_runtime_report.json" --factor-one-report "$FACTOR_ONE_REPORT" --output "$ARTIFACT_ROOT/d8_r2_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
result=pass
exit_code=0
