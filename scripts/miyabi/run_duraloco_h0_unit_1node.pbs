#!/bin/bash
#PBS -N duraloco_h0_unit
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] H0 unit gate failed at line $LINENO" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUFF_BIN="${RUFF_BIN:-$PROJECT_ROOT/.venv/bin/ruff}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" \
    --phase H0 --purpose unit --run-id "$RUN_ID" --schema-version 2 \
    --validation-shape h0-full-regression-and-static-gate-1node \
    --backend lustre --config scripts/miyabi/run_duraloco_h0_unit_1node.pbs \
    --commands-log commands.log --stdout stdout.log --stderr stderr.log \
    --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:30:00 \
    --last-qstat-state R --termination-detail "H0 static, focused, and full regression gate" \
    --assertion "committer evidence, replay conflicts, lease renewal, and bootstrap race regressions pass" \
    --assertion "prefix-scoped header-only listing and verified corruption behavior pass" \
    --assertion "multi-fragment and heartbeat-generation regressions pass" || true
}
trap finish EXIT

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1 --untracked-files=no)" ]]
[[ -x "$PYTHON_BIN" ]]
[[ -x "$RUFF_BIN" ]]
hostname | tee "$ARTIFACT_ROOT/hostname.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"

run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
}

run_command "$RUFF_BIN" check fs_diloco tests scripts/agent
run_command "$PYTHON_BIN" scripts/agent/check_no_embedded_database.py \
  --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"
run_command "$PYTHON_BIN" -m pytest -q \
  tests/distributed_syncer/test_lease_stage_guard.py \
  tests/coordination/test_lease_manager.py \
  tests/coordination/test_production_fencing.py \
  tests/storage \
  tests/lifecycle \
  tests/test_fragment_learner_multifragment.py \
  tests/test_liveness.py \
  tests/test_proposal_catalog.py \
  tests/test_config.py \
  --junitxml "$ARTIFACT_ROOT/focused-junit.xml"
run_command "$PYTHON_BIN" -m pytest -q tests --junitxml "$ARTIFACT_ROOT/full-junit.xml"
result=pass
exit_code=0
