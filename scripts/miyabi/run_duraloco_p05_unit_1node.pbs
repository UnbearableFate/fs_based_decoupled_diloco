#!/bin/bash
#PBS -N duraloco_p05_unit
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] P05 unit job failed at line $LINENO" >&2' ERR

CHECKOUT_ROOT="${CHECKOUT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$CHECKOUT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
REQUIRED_MODULES=()
for module_name in "${REQUIRED_MODULES[@]}"; do
  module load "$module_name"
done
module list 2>&1 | cat

cd "$CHECKOUT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
export PYTHONPATH="$CHECKOUT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

[[ "$(hostname)" == mg* ]]
[[ -n "${PBS_JOBID:-}" && -n "${PBS_NODEFILE:-}" ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]

hostname | tee "$ARTIFACT_ROOT/hostname.log"
printf 'PBS_JOBID=%s\nPBS_NODEFILE=%s\n' "$PBS_JOBID" "$PBS_NODEFILE" \
  | tee "$ARTIFACT_ROOT/pbs_context.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"

printf '%q ' "$PYTHON_BIN" -m pytest -q tests/coordination/test_reference_state_machine.py \
  > "$ARTIFACT_ROOT/commands.log"
printf '\n' >> "$ARTIFACT_ROOT/commands.log"

set +e
"$PYTHON_BIN" -m pytest -q tests/coordination/test_reference_state_machine.py \
  2>&1 | tee "$ARTIFACT_ROOT/pytest.log"
test_status=${PIPESTATUS[0]}
set -e

qstat "$PBS_JOBID" | tee "$ARTIFACT_ROOT/qstat_running.log"
cp "$ARTIFACT_ROOT/pytest.log" "$ARTIFACT_ROOT/stdout.log"
: > "$ARTIFACT_ROOT/stderr.log"

manifest_args=(
  --root "$CHECKOUT_ROOT"
  --output "$ARTIFACT_ROOT/manifest.json"
  --phase P05
  --purpose unit
  --run-id "$RUN_ID"
  --schema-version 2
  --validation-shape p05-coordination-reference-unit-1node
  --config scripts/miyabi/run_duraloco_p05_unit_1node.pbs
  --backend memory
  --commands-log commands.log
  --stdout stdout.log
  --stderr stderr.log
  --exit-code "$test_status"
  --pbs-queue debug-g
  --requested-resources select=1:mpiprocs=1,walltime=00:05:00
  --last-qstat-state R
  --termination-detail "coordination reference unit suite"
  --assertion "coordination reference tests execute only on a confirmed PBS compute node"
)
if [[ -n "$PARENT_RUN_ID" ]]; then
  manifest_args+=(--parent-run-id "$PARENT_RUN_ID")
fi
if (( test_status == 0 )); then
  manifest_args+=(--result pass --termination-kind success)
else
  manifest_args+=(--result fail --termination-kind test_failure)
fi
"$PYTHON_BIN" scripts/agent/create_run_manifest.py "${manifest_args[@]}"
"$PYTHON_BIN" scripts/agent/check_run_manifest.py "$ARTIFACT_ROOT/manifest.json" \
  --root "$CHECKOUT_ROOT"

exit "$test_status"
