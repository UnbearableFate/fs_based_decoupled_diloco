#!/bin/bash
#PBS -N duraloco_p06b_d2
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=2:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?}" "${RUN_ID:?}" "${ARTIFACT_ROOT:?}" "${STORAGE_ROOT:?}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/duraloco_p06b_tiny_2node.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"
TRAIN_RUN="$RUN_ID-training"
cd "$PROJECT_ROOT"
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
mapfile -t HOSTS < <(sort -u "$PBS_NODEFILE")
[[ "${#HOSTS[@]}" -eq 2 ]]
NODE_IDS=$(IFS=,; echo "${HOSTS[*]}")
mkdir -p "$ARTIFACT_ROOT" "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
result=fail; exit_code=1
finish() {
  observed=$?; [[ "$result" == pass ]] && exit_code=0 || { [[ "$observed" -eq 0 ]] || exit_code=$observed; }
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(--root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" --phase P06B --purpose contract --run-id "$RUN_ID" --schema-version 2 --validation-shape p06b-d2-no-dedicated-syncer-executor-committer-whole-node-failover --backend lustre --config scripts/miyabi/run_duraloco_p06b_d2.pbs --commands-log commands.log --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result" --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" --pbs-queue debug-g --requested-resources select=2:mpiprocs=1,walltime=00:10:00 --last-qstat-state R --termination-detail "P06B D2 executor restart, Floating Committer takeover, whole learner-node loss, committed factor-one reconfiguration" --assertion "two learner nodes host learners, LFEs, and committer candidates with zero dedicated syncer nodes" --assertion "owner LFE SIGKILL restarts marker-last and active committer SIGKILL is fenced by standby takeover" --assertion "whole owner node loss is followed by committed membership revision and storage-only successor prepare")
  [[ -n "$PARENT_RUN_ID" ]] && args+=(--parent-run-id "$PARENT_RUN_ID")
  [[ -f "$ARTIFACT_ROOT/d2_report.json" ]] && args+=(--stage-metrics-path d2_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06B D2 failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR
printf '%s\n' "${HOSTS[@]}" | tee "$ARTIFACT_ROOT/hosts.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"; git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"; module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
"$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"
command=(mpirun --bind-to none -np 2 --hostfile "$PBS_NODEFILE" /usr/bin/env PROJECT_ROOT="$PROJECT_ROOT" PYTHON_BIN="$PYTHON_BIN" CONFIG="$CONFIG" RUN_ID="$TRAIN_RUN" SHARED_ROOT="$TRAINING_ROOT" ARTIFACT_ROOT="$ARTIFACT_ROOT" NODE_IDS="$NODE_IDS" PYTHONPATH="$PROJECT_ROOT" bash scripts/chaos/run_p06b_d2_host.sh)
printf '%q ' "${command[@]}" | tee "$ARTIFACT_ROOT/commands.log"; printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${command[@]}" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json | tee "$ARTIFACT_ROOT/training_summary.json"
"$PYTHON_BIN" - "$TRAINING_ROOT" "$ARTIFACT_ROOT" "$TRAIN_RUN" <<'PY' | tee "$ARTIFACT_ROOT/d2_report.json"
import json,sys
from pathlib import Path
from fs_diloco.log.production import ProductionTransactionalLog
from fs_diloco.runtime_view import build_runtime_view
from fs_diloco.storage import PosixStorageBackend
root, artifacts, run_id = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
summary=json.loads((artifacts/'training_summary.json').read_text())
events=[json.loads(line) for line in (root/'logs/distributed_committer.jsonl').read_text().splitlines()]
faults=root/'distributed/faults'
log=ProductionTransactionalLog.open(PosixStorageBackend(root/'authority'),run_id,1)
view=build_runtime_view(log,force_full=True)
report={'status':'PASS','learner_nodes':2,'dedicated_syncer_nodes':0,'optimizer_transitions':view.optimizer_transition_count,'final_fencing_epoch':view.fencing_epoch,'membership_revision':view.membership.revision if view.membership else None,'executor_kills':len(list(faults.glob('*_executor_killed.json'))),'committer_kills':len(list(faults.glob('*_committer_killed.json'))),'whole_node_kills':len(list(faults.glob('*_whole_killed.json'))),'takeovers':sum(e.get('stage')=='fence_commit_and_strict_replay' for e in events),'membership_reconfigurations':sum(e.get('event_type')=='membership_reconfigured' for e in events),'distributed_commits':sum(e.get('event_type')=='distributed_transition_committed' for e in events),'stop_reason':summary['stop_reason']}
assert report['optimizer_transitions']==3 and report['distributed_commits']==3
assert report['final_fencing_epoch']==2 and report['takeovers']==2
assert report['membership_revision']==1 and report['membership_reconfigurations']==1
assert report['executor_kills']==report['committer_kills']==report['whole_node_kills']==1
assert report['stop_reason']=='stop_after_outer_steps'
print(json.dumps(report,indent=2,sort_keys=True))
PY
result=pass; exit_code=0
