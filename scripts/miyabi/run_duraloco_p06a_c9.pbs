#!/bin/bash
#PBS -N duraloco_p06a_c9
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=9:mpiprocs=1
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
cd "$PROJECT_ROOT"
if [[ "${TARGETED_DRY_RUN:-0}" == 1 ]]; then
  [[ -f scripts/miyabi/run_duraloco_p05_9node_gpt2_50x10.pbs ]]
  bash -n scripts/miyabi/run_duraloco_p05_9node_gpt2_50x10.pbs
  printf 'P06A_C9_WRAPPER_PATH_RESOLUTION_PASS\n'
  exit 0
fi
export MANIFEST_PHASE=P06A
export VALIDATION_SHAPE=p06a-c9-decomposed-crs-gpt2-wikitext2-50x10
export PROBE_MODULE=fs_diloco.learner_protocol.terminal_probe
export LEARNER_ZERO_WRAPPER=scripts/chaos/run_p06_terminal_learner_restart.sh
export TERMINATION_DETAIL="P06A decomposed CRS C9 with 8 learners, active/standby fenced committer takeover, and learner warm restart"
exec bash scripts/miyabi/run_duraloco_p05_9node_gpt2_50x10.pbs
