#!/bin/bash
#PBS -N duraloco_p06b_d1
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${STORAGE_ROOT:?STORAGE_ROOT is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/fs_diloco_gpt2_wikitext2_1l_debug.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"
TRAIN_RUN="$RUN_ID-training"
cd "$PROJECT_ROOT"
[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
mkdir -p "$ARTIFACT_ROOT" "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
pids=()
finish() {
  observed=$?
  for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json"
    --phase P06B --purpose contract --run-id "$RUN_ID" --schema-version 2
    --validation-shape p06b-d1-learner-lfe-floating-committer-real-gpt2
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1
    --config scripts/miyabi/run_duraloco_p06b_d1.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:30:00
    --last-qstat-state R --termination-detail "P06B D1 real learner plus separate LFE and Floating Committer on one learner node"
    --assertion "revision-zero membership and factor-one ownership are frozen in a fresh distributed generation"
    --assertion "separate prepare-only LFE publishes marker-last PFT and Floating Committer performs the only head CAS"
    --assertion "real GPT-2/WikiText-2 completes finite steps and adopts only the committed final frontier"
  )
  if [[ -n "$PARENT_RUN_ID" ]]; then args+=(--parent-run-id "$PARENT_RUN_ID"); fi
  [[ -f "$ARTIFACT_ROOT/d1_report.json" ]] && args+=(--stage-metrics-path d1_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06B D1 failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

hostname | tee "$ARTIFACT_ROOT/hosts.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
"$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"

node_id=$(hostname)
committer=("$PYTHON_BIN" -m fs_diloco.distributed_syncer.cli committer --config "$CONFIG" --run-id "$TRAIN_RUN" --shared-root "$TRAINING_ROOT" --num-learners 1 --node-ids "$node_id" --member-id member-000 --owner-session-id "$TRAIN_RUN-committer-session" --threads 8)
executor=("$PYTHON_BIN" -m fs_diloco.distributed_syncer.cli executor --config "$CONFIG" --run-id "$TRAIN_RUN" --shared-root "$TRAINING_ROOT" --num-learners 1 --member-id member-000 --executor-id executor-000 --executor-session-id "$TRAIN_RUN-executor-000-session" --threads 8)
learner=("$PYTHON_BIN" -m fs_diloco.learner --config "$CONFIG" --run-id "$TRAIN_RUN" --shared-root "$TRAINING_ROOT" --learner-id learner_000 --num-learners 1 --session-id "$TRAIN_RUN-learner_000-session")
for command in committer executor learner; do declare -n value="$command"; printf '%q ' "${value[@]}" | tee -a "$ARTIFACT_ROOT/commands.log"; printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"; done
CUDA_VISIBLE_DEVICES="" "${committer[@]}" > "$ARTIFACT_ROOT/committer.log" 2>&1 & pids+=("$!")
sleep 5
CUDA_VISIBLE_DEVICES="" "${executor[@]}" > "$ARTIFACT_ROOT/executor.log" 2>&1 & pids+=("$!")
CUDA_VISIBLE_DEVICES=0 "${learner[@]}" > "$ARTIFACT_ROOT/learner.log" 2>&1 & pids+=("$!")
wait "${pids[2]}"
wait "${pids[0]}"
wait "${pids[1]}"
pids=()

"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json | tee "$ARTIFACT_ROOT/training_summary.json"
"$PYTHON_BIN" - "$TRAINING_ROOT" "$ARTIFACT_ROOT" <<'PY' | tee "$ARTIFACT_ROOT/d1_report.json"
import csv, json, math, sys
from pathlib import Path
root, artifacts = map(Path, sys.argv[1:])
summary = json.loads((artifacts / "training_summary.json").read_text())
metrics = list(csv.DictReader((root / "metrics/learner_metrics.csv").open()))
losses = [float(row["train_loss"]) for row in metrics if row.get("train_loss")]
events = [json.loads(line) for line in (root / "logs/distributed_committer.jsonl").read_text().splitlines()]
commits = [row for row in events if row.get("event_type") == "distributed_transition_committed"]
authority = root / "authority"
markers = [p for p in authority.rglob("*.json") if "/distributed/prepared/markers/" in p.as_posix()]
learner_events = [json.loads(line) for line in (root / "logs/learner_000.jsonl").read_text().splitlines()]
report = {
  "status": "PASS", "dedicated_syncer_nodes": 0, "learner_nodes": 1,
  "learners": 1, "executors": 1, "floating_committers": 1,
  "optimizer_transitions": summary["optimizer_transition_count"],
  "stop_reason": summary["stop_reason"], "finite_losses": losses,
  "local_steps": max(int(row["local_step"]) for row in metrics),
  "prepared_markers": len(markers), "distributed_commits": len(commits),
  "boundary_adoptions": sum(row.get("event_type") == "global_adopted" for row in learner_events),
}
assert report["optimizer_transitions"] >= 1 and report["distributed_commits"] >= 1
assert report["prepared_markers"] >= 1 and report["local_steps"] <= 10
assert report["boundary_adoptions"] >= 1
assert losses and all(math.isfinite(value) for value in losses)
assert report["stop_reason"] == "stop_after_outer_steps"
print(json.dumps(report, indent=2, sort_keys=True))
PY
result=pass
exit_code=0
