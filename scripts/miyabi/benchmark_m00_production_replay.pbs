#!/bin/bash
#PBS -N m00_replay_bench
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:05:00
#PBS -j oe

set -eEuo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${AUTHORITY_ROOT:?AUTHORITY_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${OUTPUT:?OUTPUT is required}"
RUN_GENERATION="${RUN_GENERATION:-0}"

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export CUDA_VISIBLE_DEVICES=0

"$PYTHON_BIN" - "$AUTHORITY_ROOT" "$RUN_ID" "$RUN_GENERATION" "$OUTPUT" <<'PY'
import json
from pathlib import Path
import socket
import subprocess
import sys
import time

import torch

from fs_diloco.log import ProductionTransactionalLog
from fs_diloco.storage import PosixStorageBackend


authority_root = Path(sys.argv[1])
run_id = sys.argv[2]
run_generation = int(sys.argv[3])
output = Path(sys.argv[4])


def elapsed(call):
    start = time.monotonic()
    result = call()
    if torch.cuda.is_available():
        torch.cuda.synchronize()
    return result, time.monotonic() - start


gpu_backend = PosixStorageBackend(authority_root)
gpu_log = ProductionTransactionalLog.open(gpu_backend, run_id, run_generation)
gpu_log.set_replay_validation_device("cuda")
strict_gpu, strict_gpu_seconds = elapsed(lambda: gpu_log.replay(force_full=True))
if strict_gpu.head_frontier.commit_seq < 1:
    raise AssertionError("production replay benchmark requires a committed successor")

large_keys = {
    *(proposal.payload_key for proposal in strict_gpu.proposals.values()),
    *(
        fragment.params_ref.key
        for frontier in strict_gpu.frontiers
        for fragment in frontier.fragments.values()
    ),
    *(
        fragment.outer_state_ref.key
        for frontier in strict_gpu.frontiers
        for fragment in frontier.fragments.values()
    ),
}
history_start = len(gpu_backend.history)
cached, cached_seconds = elapsed(gpu_log.replay)
cached_history = gpu_backend.history[history_start:]
cached_large_gets = [
    record.key
    for record in cached_history
    if record.operation == "get" and record.key in large_keys
]
if cached != strict_gpu:
    raise AssertionError("memoized replay differs from strict GPU replay")
if cached_large_gets:
    raise AssertionError(f"memoized replay reread large tensors: {cached_large_gets}")

cpu_backend = PosixStorageBackend(authority_root)
cpu_log = ProductionTransactionalLog.open(cpu_backend, run_id, run_generation)
strict_cpu, strict_cpu_seconds = elapsed(lambda: cpu_log.replay(force_full=True))
if strict_cpu != strict_gpu:
    raise AssertionError("strict CPU and GPU production replay results differ")

report = {
    "status": "PASS",
    "kind": "m00-production-replay-real-prefix-benchmark",
    "hostname": socket.gethostname(),
    "git_commit": subprocess.check_output(
        ["git", "rev-parse", "HEAD"], text=True
    ).strip(),
    "authority_root": str(authority_root),
    "run_id": run_id,
    "run_generation": run_generation,
    "commit_seq": strict_gpu.head_frontier.commit_seq,
    "committed_state_digest": strict_gpu.committed_state_digest,
    "proposal_count": len(strict_gpu.proposals),
    "large_object_count": len(large_keys),
    "strict_gpu_seconds": strict_gpu_seconds,
    "memoized_seconds": cached_seconds,
    "strict_cpu_seconds": strict_cpu_seconds,
    "memoized_get_count": sum(
        record.operation == "get" for record in cached_history
    ),
    "memoized_large_get_count": len(cached_large_gets),
}
output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
print(json.dumps(report, sort_keys=True))
PY
