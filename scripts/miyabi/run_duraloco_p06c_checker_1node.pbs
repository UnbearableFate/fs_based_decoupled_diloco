#!/bin/bash
#PBS -N duraloco_p06c_check
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${PARENT_RUN_ID:?PARENT_RUN_ID is required}"
: "${MAKER_TARGETED:?MAKER_TARGETED is required}"
: "${MAKER_UNIT:?MAKER_UNIT is required}"
: "${MAKER_D1:?MAKER_D1 is required}"
: "${MAKER_D2:?MAKER_D2 is required}"
: "${MAKER_D8:?MAKER_D8 is required}"
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" \
    --phase P06C --purpose contract --run-id "$RUN_ID" --parent-run-id "$PARENT_RUN_ID" --schema-version 2 \
    --validation-shape p06c-independent-checker-1node \
    --backend lustre --config scripts/miyabi/run_duraloco_p06c_checker_1node.pbs \
    --commands-log commands.log --stdout stdout.log --stderr stderr.log \
    --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:15:00 --last-qstat-state R \
    --termination-detail "Independent P06C factor-two, failure, D8, lifecycle, and error-ledger audit" \
    --assertion "all 24 P06C acceptance IDs and targeted/unit/D1/D2/D8 lineage are independently audited" \
    --assertion "false suspicion cannot change ownership and same-FWO divergence fails closed with both IDs" \
    --assertion "D8 failure/retry ladder, negative comparison, checksums, and P07 lifecycle handoff pass"
}
trap finish EXIT
trap 'echo "[ERROR] P06C Checker failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
hostname | tee "$ARTIFACT_ROOT/hostname.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
}
run_command "$PYTHON_BIN" scripts/agent/check_research_contract.py --root "$PROJECT_ROOT"
run_command "$PYTHON_BIN" scripts/agent/check_phase_state.py plans/duraloco/STATE.yaml --root "$PROJECT_ROOT"
run_command bash -n scripts/miyabi/*.pbs
run_command "$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"
printf '%q ' "$PYTHON_BIN" -m fs_diloco.testing.reference_cli --count 10000 --steps 12 | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"$PYTHON_BIN" -m fs_diloco.testing.reference_cli --count 10000 --steps 12 | tee "$ARTIFACT_ROOT/reference_10000.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
run_command "$PYTHON_BIN" -m pytest -q tests --junitxml "$ARTIFACT_ROOT/junit.xml"
run_command "$PYTHON_BIN" scripts/agent/check_p06c_final.py --root "$PROJECT_ROOT" --artifact-root "$ARTIFACT_ROOT" --manifest "$MAKER_TARGETED" --manifest "$MAKER_UNIT" --manifest "$MAKER_D1" --manifest "$MAKER_D2" --manifest "$MAKER_D8" --output "$ARTIFACT_ROOT/checker_results.json"
result=pass
exit_code=0
