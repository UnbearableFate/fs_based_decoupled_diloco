#!/bin/bash
#PBS -N duraloco_p08r_r2
#PBS -q regular-g
#PBS -W group_list=xg24i002
#PBS -l select=8:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
export FS_DILOCO_CAPSULE_CADENCE=1 FS_DILOCO_CAPSULE_MAX_SEQUENCE=1
: "${EXPECTED_COMMIT:?}" "${RUN_ID:?}" "${ARTIFACT_ROOT:?}" "${STORAGE_ROOT:?}"
: "${FACTOR_ONE_REPORT:?}"
PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
CONFIG="$PROJECT_ROOT/configs/duraloco_milestone_gpt2_8node_50x10.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"
TRAIN_RUN="$RUN_ID-training"
experiment_started_ns=$(date +%s%N)
cd "$PROJECT_ROOT"
mkdir -p "$(dirname "$ARTIFACT_ROOT")" "$(dirname "$STORAGE_ROOT")"
if ! mkdir "$STORAGE_ROOT"; then
  echo "refusing reused P08 storage root: $STORAGE_ROOT" >&2
  exit 2
fi
if ! mkdir "$ARTIFACT_ROOT"; then
  echo "refusing reused P08 artifact root: $ARTIFACT_ROOT" >&2
  exit 2
fi
mkdir "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
result=fail; exit_code=1
runtime_started_ns=0
runtime_ended_ns=0

finish() {
  observed=$?
  [[ "$result" == pass ]] && exit_code=0 || { [[ "$observed" -eq 0 ]] || exit_code=$observed; }
  experiment_ended_ns=$(date +%s%N)
  if (( runtime_started_ns > 0 && runtime_ended_ns >= runtime_started_ns )); then
    if ! "$PYTHON_BIN" scripts/agent/create_p08r_elapsed_report.py \
      --experiment-started-ns "$experiment_started_ns" \
      --runtime-started-ns "$runtime_started_ns" \
      --runtime-ended-ns "$runtime_ended_ns" \
      --experiment-ended-ns "$experiment_ended_ns" \
      --max-experiment-seconds 600 \
      --output "$ARTIFACT_ROOT/elapsed_contract.json" \
      >> "$ARTIFACT_ROOT/stdout.log" 2>> "$ARTIFACT_ROOT/stderr.log"; then
      result=fail
      exit_code=1
    fi
  fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(--root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" --phase P08R
    --purpose experiment --run-id "$RUN_ID" --schema-version 2
    --validation-shape p08r-d8-r2-eight-node-controlled-fault-gpt2-wikitext2-50x10
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1
    --config scripts/miyabi/run_duraloco_p08_d8_r2.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue regular-g --requested-resources select=8:mpiprocs=1,walltime=00:30:00
    --last-qstat-state R --termination-detail "P08 D8-R2 eight-node 50x10, controlled executor fault, matched factor-one interference and bundle gate"
    --assertion "hedged factor two recovers one recorded executor exception with complete loser-attempt telemetry"
    --assertion "ten single-head transitions, raw profiles, matched eight-node factor-one/R2 interference, and D-0807 gate pass"
    --assertion "the error-recovery complete experiment fits the user-approved practical 600-second envelope"
    --assertion "periodic lifecycle cycles defer redundant strict replay to the mandatory terminal strict audit"
    --assertion "P07 strict/snapshot replay, capsules, reachability, bounded lifecycle dry-runs, and lifecycle regressions pass")
  [[ -f "$ARTIFACT_ROOT/p08_d8_r2_report.json" ]] && args+=(--stage-metrics-path p08_d8_r2_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P08 D8-R2 failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1 --untracked-files=no)" ]]
[[ -f "$FACTOR_ONE_REPORT" ]]
mapfile -t ALL_HOSTS < <(sort -u "$PBS_NODEFILE")
[[ "${#ALL_HOSTS[@]}" -eq 8 ]]
LEARNER_HOSTS=("${ALL_HOSTS[@]}")
printf '%s\n' "${ALL_HOSTS[@]}" | tee "$ARTIFACT_ROOT/hosts.log"
printf '%s\n' "${LEARNER_HOSTS[@]}" > "$ARTIFACT_ROOT/learner_hosts.log"
NODE_IDS=$(IFS=,; echo "${LEARNER_HOSTS[*]}")
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
findmnt -T "$TRAINING_ROOT" > "$ARTIFACT_ROOT/mount.log" 2>&1 || true
lfs getstripe "$TRAINING_ROOT" > "$ARTIFACT_ROOT/stripe.log" 2>&1 || true
"$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" \
  --output "$ARTIFACT_ROOT/forbidden_surface.json"

command=(mpirun --bind-to none -np 8 --hostfile "$ARTIFACT_ROOT/learner_hosts.log"
  /usr/bin/env PROJECT_ROOT="$PROJECT_ROOT" PYTHON_BIN="$PYTHON_BIN" CONFIG="$CONFIG"
  RUN_ID="$TRAIN_RUN" SHARED_ROOT="$TRAINING_ROOT" ARTIFACT_ROOT="$ARTIFACT_ROOT"
  NODE_IDS="$NODE_IDS" PYTHONPATH="$PROJECT_ROOT" WANDB_MODE=disabled
  FS_DILOCO_CAPSULE_CADENCE=1 FS_DILOCO_CAPSULE_MAX_SEQUENCE=1
  bash scripts/miyabi/run_p08_d8_r2_host.sh)
printf '%q ' "${command[@]}" | tee "$ARTIFACT_ROOT/commands.log"; printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
runtime_started_ns=$(date +%s%N)
"${command[@]}" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
runtime_ended_ns=$(date +%s%N)

"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json \
  | tee "$ARTIFACT_ROOT/training_summary.json"
elapsed=$(( (runtime_ended_ns - runtime_started_ns + 999999999) / 1000000000 ))
"$PYTHON_BIN" scripts/agent/create_p08_performance_report.py r2 \
  --root "$TRAINING_ROOT" --artifacts "$ARTIFACT_ROOT" --run-id "$TRAIN_RUN" \
  --config "$CONFIG" --elapsed-seconds "$elapsed" \
  --output "$ARTIFACT_ROOT/p08_d8_r2_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p08_performance_report.py compare \
  --factor-one-report "$FACTOR_ONE_REPORT" \
  --r2-report "$ARTIFACT_ROOT/p08_d8_r2_report.json" \
  --output "$ARTIFACT_ROOT/interference_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p08_performance_report.py gate \
  --factor-one-report "$FACTOR_ONE_REPORT" --r2-report "$ARTIFACT_ROOT/p08_d8_r2_report.json" \
  --interference-report "$ARTIFACT_ROOT/interference_report.json" \
  --output "$ARTIFACT_ROOT/bundle_gate_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p07_lifecycle_report.py --root "$TRAINING_ROOT" \
  --run-id "$TRAIN_RUN" --run-generation 0 --expected-learners 8 --require-bounded-window \
  --bounded-window-delta 80 --runtime-terminal-audit \
  --output "$ARTIFACT_ROOT/p07_lifecycle_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" -m pytest -q tests/lifecycle tests/log/test_replay_prefix.py \
  --junitxml "$ARTIFACT_ROOT/p07_regression_junit.xml" | tee -a "$ARTIFACT_ROOT/stdout.log"
result=pass; exit_code=0
