#!/bin/bash
#PBS -N p08r_lifecycle
#PBS -q debug-g
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:15:00
#PBS -W group_list=xg24i002
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] line=$LINENO status=$?" >&2' ERR

: "${EXPECTED_COMMIT:?set the clean P08R lifecycle repair commit}"
: "${RUN_ID:?set a unique benchmark run ID}"
: "${ARTIFACT_ROOT:?set a fresh benchmark artifact root}"
: "${SOURCE_TRAINING_ROOT:?set the frozen failed D8-R2 training root}"
: "${SOURCE_RUN_ID:?set the frozen failed D8-R2 training run ID}"

PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
cd "$PROJECT_ROOT"
mkdir -p "$(dirname "$ARTIFACT_ROOT")"
if ! mkdir "$ARTIFACT_ROOT"; then
  echo "refusing reused P08R lifecycle artifact root: $ARTIFACT_ROOT" >&2
  exit 2
fi
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log"
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  [[ "$result" == pass ]] && exit_code=0 || { [[ "$observed" -eq 0 ]] || exit_code=$observed; }
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" --phase P08R \
    --purpose benchmark --run-id "$RUN_ID" --schema-version 2 \
    --validation-shape p08r-frozen-d8-r2-deferred-lifecycle-1node \
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1 \
    --config scripts/miyabi/run_duraloco_p08r_lifecycle_1node.pbs \
    --commands-log commands.log --stdout stdout.log --stderr stderr.log \
    --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:15:00 \
    --last-qstat-state R \
    --termination-detail "P08R deferred periodic lifecycle audit benchmark on frozen R2 authority" \
    --assertion "periodic snapshot, reachability, and inventory complete within ten seconds" \
    --assertion "one terminal empty-cache strict audit equals snapshot replay and authority remains unchanged" || true
}
trap finish EXIT

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1 --untracked-files=no)" ]]
printf '%s\n' \
  "$PYTHON_BIN -m pytest tests/distributed_syncer/test_lease_stage_guard.py tests/performance_core/test_p08_performance_report.py -q" \
  "$PYTHON_BIN -m pytest tests/lifecycle/test_snapshot_suffix_replay.py tests/log/test_production_runtime.py -q" \
  "$PYTHON_BIN -m benchmarks.bench_p08r_snapshot_suffix_memo --training-root $SOURCE_TRAINING_ROOT --run-id $SOURCE_RUN_ID --output $ARTIFACT_ROOT/snapshot_suffix_benchmark.json" \
  > "$ARTIFACT_ROOT/commands.log"
"$PYTHON_BIN" -m pytest \
  tests/distributed_syncer/test_lease_stage_guard.py \
  tests/performance_core/test_p08_performance_report.py \
  tests/lifecycle/test_snapshot_suffix_replay.py \
  tests/log/test_production_runtime.py -q \
  > >(tee "$ARTIFACT_ROOT/stdout.log") \
  2> >(tee "$ARTIFACT_ROOT/stderr.log" >&2)
"$PYTHON_BIN" -m benchmarks.bench_p08r_snapshot_suffix_memo \
  --training-root "$SOURCE_TRAINING_ROOT" --run-id "$SOURCE_RUN_ID" \
  --output "$ARTIFACT_ROOT/snapshot_suffix_benchmark.json" \
  > >(tee -a "$ARTIFACT_ROOT/stdout.log") \
  2> >(tee -a "$ARTIFACT_ROOT/stderr.log" >&2)
result=pass
exit_code=0
