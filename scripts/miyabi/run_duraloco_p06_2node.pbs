#!/bin/bash
#PBS -N duraloco_p06_2n
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=2:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
: "${PBS_NODEFILE:?PBS_NODEFILE is required}"
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${SHARED_ROOT:?SHARED_ROOT is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/duraloco_p06_tiny_2node_restart.yaml"

cd "$PROJECT_ROOT"
mapfile -t HOSTS < <(sort -u "$PBS_NODEFILE")
[[ "${#HOSTS[@]}" -eq 2 ]]
[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
mkdir -p "$ARTIFACT_ROOT" "$SHARED_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json"
    --phase P06 --purpose chaos --run-id "$RUN_ID" --schema-version 2
    --validation-shape p06-maker-2node-learner-syncer-warm-restart
    --backend lustre --config scripts/miyabi/run_duraloco_p06_2node.pbs
    --commands-log commands.log --stdout stdout.log --stderr stderr.log
    --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue debug-g --requested-resources select=2:mpiprocs=1,walltime=00:10:00
    --last-qstat-state R --termination-detail "P06 separate-node syncer/learner publication, learner SIGKILL, warm restart, boundary adoption, and stop"
    --assertion "syncer and learner execute on distinct compute hosts"
    --assertion "learner is SIGKILLed after marker-last publication and restarts with a distinct immutable session"
    --assertion "two non-overlapping intervals commit, boundary adoption occurs, and authoritative stop wins"
  )
  if [[ -n "$PARENT_RUN_ID" ]]; then args+=(--parent-run-id "$PARENT_RUN_ID"); fi
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06 two-node gate failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

printf '%s\n' "${HOSTS[@]}" | tee "$ARTIFACT_ROOT/hosts.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"

MPI_ENV=(
  "PROJECT_ROOT=$PROJECT_ROOT" "PYTHON_BIN=$PYTHON_BIN" "CONFIG=$CONFIG"
  "RUN_ID=$RUN_ID-training" "SHARED_ROOT=$SHARED_ROOT" "ARTIFACT_ROOT=$ARTIFACT_ROOT"
  "PYTHONPATH=$PYTHONPATH" "WANDB_MODE=disabled"
)
COMMAND=(mpirun --bind-to none -np 2 --hostfile "$PBS_NODEFILE" /usr/bin/env "${MPI_ENV[@]}" bash -lc
  'set -eEuo pipefail; rank="${OMPI_COMM_WORLD_RANK:?}"; cd "$PROJECT_ROOT"; if [[ "$rank" -eq 0 ]]; then export CUDA_VISIBLE_DEVICES=0; exec "$PYTHON_BIN" -m fs_diloco.syncer --config "$CONFIG" --run-id "$RUN_ID" --shared-root "$SHARED_ROOT" --num-learners 1 --owner-id syncer-a --owner-session-id "$RUN_ID-owner"; else exec bash scripts/chaos/run_p06_learner_restart.sh; fi')
printf '%q ' "${COMMAND[@]}" | tee "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${COMMAND[@]}" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"

"$PYTHON_BIN" -m fs_diloco.analysis summary "$SHARED_ROOT" --json \
  | tee "$ARTIFACT_ROOT/training_summary.json"
"$PYTHON_BIN" - "$SHARED_ROOT" "$ARTIFACT_ROOT" <<'PY' | tee "$ARTIFACT_ROOT/two_node_report.json"
import json
from pathlib import Path
import sys

root, artifacts = map(Path, sys.argv[1:])
summary = json.loads((artifacts / "training_summary.json").read_text())
events = [json.loads(line) for line in (artifacts / "learner_000.log").read_text().splitlines() if line.strip()]
updates = [json.loads(path.read_text()) for path in root.glob("updates/pending/learner_000/update_*.meta.json")]
assert (artifacts / "learner_kill.json").is_file()
assert summary["optimizer_transition_count"] == 2
assert summary["stop_reason"] == "stop_after_outer_steps"
recoveries = [event for event in events if event.get("event") == "warm_recovery"]
sessions = {event["new_session"]["learner_session_id"] for event in recoveries}
assert len(recoveries) >= 2 and len(sessions) >= 2
assert len(updates) >= 2
intervals = {(item["learner_session_id"], item["proposal_sequence"]): (item["local_step_start"], item["local_step_end"]) for item in updates}
assert len(intervals) == len(updates)
assert all(start < end for start, end in intervals.values())
assert any(event.get("event") == "global_adopted" for event in events)
report = {
    "status": "PASS",
    "optimizer_transitions": 2,
    "session_ids": sorted(sessions),
    "published_intervals": len(updates),
    "warm_not_exact": all(event["warm_not_exact"] for event in recoveries),
    "authoritative_stop": summary["stop_reason"],
}
print(json.dumps(report, indent=2, sort_keys=True))
PY

result=pass
exit_code=0
