#!/bin/bash
#PBS -N duraloco_p06_1n
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${STORAGE_ROOT:?STORAGE_ROOT is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/fs_diloco_gpt2_wikitext2_1l_debug.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"

cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT" "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
[[ "$(hostname)" == mg* ]]
[[ -n "${PBS_JOBID:-}" && -n "${PBS_NODEFILE:-}" ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json"
    --phase P06 --purpose contract --run-id "$RUN_ID" --schema-version 2
    --validation-shape p06-maker-1node-gpt2-wikitext2-interval-adoption
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1
    --config scripts/miyabi/run_duraloco_p06_1node.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:30:00
    --last-qstat-state R --termination-detail "P06 full suite and one-node real GPT-2/WikiText-2 interval publication/adoption"
    --assertion "all dependency tests and the forbidden embedded-database scan pass"
    --assertion "real GPT-2/WikiText-2 loss is finite within two local steps"
    --assertion "learner publishes one immutable interval and adopts only at its boundary"
  )
  if [[ -n "$PARENT_RUN_ID" ]]; then args+=(--parent-run-id "$PARENT_RUN_ID"); fi
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06 one-node gate failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

hostname | tee "$ARTIFACT_ROOT/hostname.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
findmnt -T "$STORAGE_ROOT" > "$ARTIFACT_ROOT/mount.log" 2>&1 || true

run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
}

run_command "$PYTHON_BIN" scripts/agent/check_phase_state.py plans/duraloco/STATE.yaml --root "$PROJECT_ROOT"
run_command "$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"
run_command "$PYTHON_BIN" -m fs_diloco.testing.reference_cli --count 1000 --steps 12
run_command "$PYTHON_BIN" -m pytest -q tests --junitxml "$ARTIFACT_ROOT/junit.xml"

CUDA_VISIBLE_DEVICES=0 "$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" --run-id "$RUN_ID-training" --shared-root "$TRAINING_ROOT" \
  --num-learners 1 --owner-id syncer-a --owner-session-id "$RUN_ID-owner" \
  > "$ARTIFACT_ROOT/syncer.log" 2>&1 &
syncer_pid=$!
sleep 5
CUDA_VISIBLE_DEVICES=0 "$PYTHON_BIN" -m fs_diloco.learner \
  --config "$CONFIG" --run-id "$RUN_ID-training" --shared-root "$TRAINING_ROOT" \
  --learner-id learner_000 --num-learners 1 \
  > "$ARTIFACT_ROOT/learner.log" 2>&1 &
learner_pid=$!
wait "$learner_pid"
wait "$syncer_pid"
run_command "$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json
"$PYTHON_BIN" - "$TRAINING_ROOT" "$ARTIFACT_ROOT/learner.log" "$ARTIFACT_ROOT/one_node_report.json" <<'PY'
import csv
import json
import math
from pathlib import Path
import sys

root, learner_log, output = map(Path, sys.argv[1:])
events = [json.loads(line) for line in learner_log.read_text().splitlines() if line.strip()]
metrics = list(csv.DictReader((root / "metrics" / "learner_metrics.csv").open()))
losses = [float(row["train_loss"]) for row in metrics if row.get("train_loss")]
assert losses and all(math.isfinite(value) for value in losses)
written = [event for event in events if event.get("event") in {"update_written", "fragment_update_written"}]
assert len(written) == 1
assert written[0]["interval_digest"]
assert written[0]["publication_request_id"]
assert any(event.get("event") == "warm_recovery" for event in events)
assert any(event.get("event") == "global_adopted" for event in events)
report = {
    "status": "PASS",
    "finite_losses": losses,
    "local_steps": max(int(row["local_step"]) for row in metrics),
    "published_intervals": len(written),
    "boundary_adoptions": sum(event.get("event") == "global_adopted" for event in events),
    "publication_request_ids": [event["publication_request_id"] for event in written],
}
assert report["local_steps"] <= 10
output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
print(json.dumps(report, sort_keys=True))
PY
cat "$ARTIFACT_ROOT/one_node_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"

result=pass
exit_code=0
