#!/bin/bash
#PBS -N duraloco_p06c_lease
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${PARENT_RUN_ID:?PARENT_RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" \
    --phase P06C --purpose contract --run-id "$RUN_ID" --parent-run-id "$PARENT_RUN_ID" --schema-version 2 \
    --validation-shape p06c-d8-lease-stage-guard-targeted-1node \
    --backend memory --config scripts/miyabi/run_duraloco_p06c_lease_guard_1node.pbs \
    --commands-log commands.log --stdout stdout.log --stderr stderr.log \
    --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:10:00 --last-qstat-state R \
    --termination-detail "Targeted proof for post-activation, membership, and work-dispatch lease renewal guards" \
    --assertion "all three authoritative stage guards call the renewal primitive and emit exact stage telemetry" \
    --assertion "membership and work publication call sites are structurally ordered after their guard" \
    --assertion "the underlying lease manager renewal conflict and expiry semantics remain covered"
}
trap finish EXIT
trap 'echo "[ERROR] P06C lease guard failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
hostname | tee "$ARTIFACT_ROOT/hostname.log"
command=("$PYTHON_BIN" -m pytest -q tests/distributed_syncer/test_lease_stage_guard.py tests/coordination/test_lease_manager.py --junitxml "$ARTIFACT_ROOT/junit.xml")
printf '%q ' "${command[@]}" | tee "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${command[@]}" 2>&1 | tee "$ARTIFACT_ROOT/stdout.log"
result=pass
exit_code=0
