#!/bin/bash
#PBS -N duraloco_p07_d2
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=2:mpiprocs=1
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled
export FS_DILOCO_CAPSULE_CADENCE=1
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${STORAGE_ROOT:?STORAGE_ROOT is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/duraloco_p06c_tiny_2node.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"
TRAIN_RUN="$RUN_ID-training"
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT" "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json"
    --phase P07 --purpose chaos --run-id "$RUN_ID" --schema-version 2
    --validation-shape p07-d2-r2-failover-with-snapshot-capsule-and-gc-dry-run
    --backend lustre --model-revision synthetic-tiny --dataset-revision synthetic-v1
    --config scripts/miyabi/run_duraloco_p07_d2_r2.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue debug-g --requested-resources select=2:mpiprocs=1,walltime=00:15:00
    --last-qstat-state R --termination-detail "P07 D2-R2 lifecycle under executor, committer, and whole-host failure"
    --assertion "takeover uses storage-only replay and a validated pinned snapshot without crossing owner cache"
    --assertion "exact capsules and reachability roots survive executor/committer/whole-host failure"
    --assertion "all GC cycles remain dry-run and head/epoch revalidation preserves live objects"
  )
  if [[ -n "$PARENT_RUN_ID" ]]; then args+=(--parent-run-id "$PARENT_RUN_ID"); fi
  [[ -f "$ARTIFACT_ROOT/p07_d2_report.json" ]] && args+=(--stage-metrics-path p07_d2_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P07 D2-R2 failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1 --untracked-files=no)" ]]
[[ "$STORAGE_ROOT" == "$PROJECT_ROOT"/* ]]
sort -u "$PBS_NODEFILE" | tee "$ARTIFACT_ROOT/hosts.log"
[[ "$(sort -u "$PBS_NODEFILE" | wc -l)" -eq 2 ]]
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
"$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"

NODE_IDS=$(sort -u "$PBS_NODEFILE" | paste -sd, -)
command=(mpirun --bind-to none -np 2 --hostfile "$PBS_NODEFILE" /usr/bin/env PROJECT_ROOT="$PROJECT_ROOT" PYTHON_BIN="$PYTHON_BIN" CONFIG="$CONFIG" RUN_ID="$TRAIN_RUN" SHARED_ROOT="$TRAINING_ROOT" ARTIFACT_ROOT="$ARTIFACT_ROOT" NODE_IDS="$NODE_IDS" LIFECYCLE_CADENCE=1 FS_DILOCO_CAPSULE_CADENCE=1 DETERMINISTIC_COMMITTER_FAILOVER=1 PYTHONPATH="$PROJECT_ROOT" bash scripts/chaos/run_p06c_d2_r2_host.sh)
printf '%q ' "${command[@]}" | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${command[@]}" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"

"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json | tee "$ARTIFACT_ROOT/training_summary.json"
"$PYTHON_BIN" scripts/agent/create_p06c_runtime_report.py --root "$TRAINING_ROOT" --run-id "$TRAIN_RUN" --run-generation 1 --expected-mode active_active --expected-learners 2 --allow-degraded-attempts --output "$ARTIFACT_ROOT/d2_r2_runtime_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p06c_d2_report.py --root "$TRAINING_ROOT" --base-report "$ARTIFACT_ROOT/d2_r2_runtime_report.json" --training-summary "$ARTIFACT_ROOT/training_summary.json" --output "$ARTIFACT_ROOT/d2_r2_failure_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p07_lifecycle_report.py --root "$TRAINING_ROOT" --run-id "$TRAIN_RUN" --run-generation 1 --expected-learners 2 --output "$ARTIFACT_ROOT/p07_d2_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
result=pass
exit_code=0
