#!/bin/bash
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
trap 'echo "[ERROR] Failed at line $LINENO" >&2' ERR

export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat
REQUIRED_MODULES=()  # Intentionally use Miyabi-G's compute-node default stack.
for module_name in "${REQUIRED_MODULES[@]}"; do
  module load "$module_name"
done
module list 2>&1 | cat

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)_duraloco_p00_baseline}"
ARTIFACT_ROOT="${ARTIFACT_ROOT:-$PROJECT_ROOT/artifacts/duraloco/P00/$RUN_ID}"
FULL_RUN_ID="${RUN_ID}_full"
FRAGMENT_RUN_ID="${RUN_ID}_fragment"
LEGACY_RUN_ROOT="${LEGACY_RUN_ROOT:-$PROJECT_ROOT/runs/fs_diloco/20260710_013757_fs_diloco_gpt2_wikitext2_8l_fragment_5000steps}"

if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python executable not found or not executable: $PYTHON_BIN" >&2
  exit 2
fi

cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
hostname | tee "$ARTIFACT_ROOT/hostname.log"
printf 'PBS_JOBID=%s\nPBS_NODEFILE=%s\n' "${PBS_JOBID:-}" "${PBS_NODEFILE:-}" \
  | tee "$ARTIFACT_ROOT/pbs_environment.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
: > "$ARTIFACT_ROOT/commands.log"

TEST_COMMAND=("$PYTHON_BIN" -m pytest -q tests --junitxml "$ARTIFACT_ROOT/junit.xml")
printf '%q ' "${TEST_COMMAND[@]}" | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${TEST_COMMAND[@]}" 2>&1 | tee "$ARTIFACT_ROOT/pytest.log"

qstat "$PBS_JOBID" | tee "$ARTIFACT_ROOT/qstat_after_pytest.log"

FULL_COMMAND=(
  env
  "PROJECT_ROOT=$PROJECT_ROOT"
  "PYTHON_BIN=$PYTHON_BIN"
  "CONFIG=$PROJECT_ROOT/configs/fs_diloco_tiny_local.yaml"
  "RUN_ID=$FULL_RUN_ID"
  "SHARED_ROOT=$PROJECT_ROOT/runs/fs_diloco/$FULL_RUN_ID"
  "SYNCER_DB_DIR=${TMPDIR:-/tmp}/fs_diloco/$FULL_RUN_ID"
  "$PROJECT_ROOT/scripts/local/run_tiny_2proc_smoke.sh"
)
printf '%q ' "${FULL_COMMAND[@]}" | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${FULL_COMMAND[@]}" 2>&1 | tee "$ARTIFACT_ROOT/full_smoke.log"

FRAGMENT_COMMAND=(
  env
  "PROJECT_ROOT=$PROJECT_ROOT"
  "PYTHON_BIN=$PYTHON_BIN"
  "CONFIG=$PROJECT_ROOT/configs/fs_diloco_tiny_fragment_local.yaml"
  "RUN_ID=$FRAGMENT_RUN_ID"
  "SHARED_ROOT=$PROJECT_ROOT/runs/fs_diloco/$FRAGMENT_RUN_ID"
  "SYNCER_DB_DIR=${TMPDIR:-/tmp}/fs_diloco/$FRAGMENT_RUN_ID"
  "$PROJECT_ROOT/scripts/local/run_tiny_2proc_smoke.sh"
)
printf '%q ' "${FRAGMENT_COMMAND[@]}" | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"${FRAGMENT_COMMAND[@]}" 2>&1 | tee "$ARTIFACT_ROOT/fragment_smoke.log"

"$PYTHON_BIN" scripts/agent/verify_baseline_evidence.py \
  "$PROJECT_ROOT/runs/fs_diloco/$FULL_RUN_ID" \
  --allow-stop-reason no_progress_timeout \
  --output "$ARTIFACT_ROOT/full_smoke_evidence.json"
"$PYTHON_BIN" scripts/agent/verify_baseline_evidence.py \
  "$PROJECT_ROOT/runs/fs_diloco/$FRAGMENT_RUN_ID" \
  --output "$ARTIFACT_ROOT/fragment_smoke_evidence.json"
"$PYTHON_BIN" scripts/agent/verify_baseline_evidence.py \
  "$LEGACY_RUN_ROOT" \
  --output "$ARTIFACT_ROOT/legacy_run_sample.json"

qstat "$PBS_JOBID" | tee "$ARTIFACT_ROOT/qstat_final.log"

# Preserve separate stdout/stderr paths required by the run-manifest schema.
cp "$ARTIFACT_ROOT/pytest.log" "$ARTIFACT_ROOT/stdout.log"
: > "$ARTIFACT_ROOT/stderr.log"
"$PYTHON_BIN" scripts/agent/create_run_manifest.py \
  --root "$PROJECT_ROOT" \
  --output "$ARTIFACT_ROOT/manifest.json" \
  --phase P00 \
  --purpose smoke \
  --backend lustre \
  --dataset-revision synthetic-v1 \
  --model-revision synthetic-tiny-v1 \
  --commands-log commands.log \
  --stdout stdout.log \
  --stderr stderr.log \
  --exit-code 0 \
  --result pass \
  --assertion "full dependency-complete pytest suite passed" \
  --assertion "full-vector tiny smoke finite evidence was preserved with BASE-001 limitation" \
  --assertion "fragment tiny smoke produced finite loss and complete artifacts" \
  --assertion "representative legacy run sample passed evidence checks"
"$PYTHON_BIN" scripts/agent/check_run_manifest.py "$ARTIFACT_ROOT/manifest.json"
