#!/bin/bash
#PBS -N p08_r2_report
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:15:00
#PBS -j oe

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
: "${EXPECTED_COMMIT:?}" "${RUN_ID:?}" "${ARTIFACT_ROOT:?}"
: "${TRAINING_ROOT:?}" "${SOURCE_ARTIFACT_ROOT:?}" "${TRAIN_RUN_ID:?}"
: "${SOURCE_COMMIT:?}" "${SOURCE_ELAPSED_SECONDS:?}"
: "${NO_LFE_REPORT:?}" "${FACTOR_ONE_REPORT:?}"
PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
CONFIG="$PROJECT_ROOT/configs/duraloco_milestone_gpt2_9node_50x10.yaml"
cd "$PROJECT_ROOT"
mkdir "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
result=fail; exit_code=1

finish() {
  observed=$?
  [[ "$result" == pass ]] && exit_code=0 || { [[ "$observed" -eq 0 ]] || exit_code=$observed; }
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(--root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" --phase P08
    --purpose benchmark --run-id "$RUN_ID" --schema-version 2
    --validation-shape p08-d8-r2-cardinality-report-recovery-1node --backend lustre
    --config scripts/miyabi/run_duraloco_p08_r2_report_recovery.pbs
    --commands-log commands.log --stdout stdout.log --stderr stderr.log
    --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:15:00
    --last-qstat-state R --termination-detail "P08-E027 preserved R2 lineage report proof"
    --assertion "ten factor-two timelines contain twenty attempts, nineteen prepared results, and one controlled terminal loser"
    --assertion "preserved terminal R2 evidence produces matched interference, bundle gate, and P07 lifecycle reports")
  [[ -f "$ARTIFACT_ROOT/p08_d8_r2_report.json" ]] && args+=(--stage-metrics-path p08_d8_r2_report.json)
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P08 R2 report recovery failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1 --untracked-files=no)" ]]
[[ "$(<"$SOURCE_ARTIFACT_ROOT/git_commit.log")" == "$SOURCE_COMMIT" ]]

run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2> >(tee -a "$ARTIFACT_ROOT/stderr.log" >&2) | tee -a "$ARTIFACT_ROOT/stdout.log"
}

run_command "$PYTHON_BIN" -m pytest -q \
  tests/performance_core/test_p08_performance_report.py
run_command "$PYTHON_BIN" scripts/agent/create_p08_performance_report.py r2 \
  --root "$TRAINING_ROOT" --artifacts "$SOURCE_ARTIFACT_ROOT" --run-id "$TRAIN_RUN_ID" \
  --config "$CONFIG" --elapsed-seconds "$SOURCE_ELAPSED_SECONDS" \
  --output "$ARTIFACT_ROOT/p08_d8_r2_report.json"
run_command "$PYTHON_BIN" scripts/agent/create_p08_performance_report.py compare \
  --no-lfe-report "$NO_LFE_REPORT" --factor-one-report "$FACTOR_ONE_REPORT" \
  --r2-report "$ARTIFACT_ROOT/p08_d8_r2_report.json" \
  --output "$ARTIFACT_ROOT/interference_report.json"
run_command "$PYTHON_BIN" scripts/agent/create_p08_performance_report.py gate \
  --factor-one-report "$FACTOR_ONE_REPORT" \
  --r2-report "$ARTIFACT_ROOT/p08_d8_r2_report.json" \
  --interference-report "$ARTIFACT_ROOT/interference_report.json" \
  --output "$ARTIFACT_ROOT/bundle_gate_report.json"
run_command "$PYTHON_BIN" scripts/agent/create_p07_lifecycle_report.py \
  --root "$TRAINING_ROOT" --run-id "$TRAIN_RUN_ID" --run-generation 0 \
  --expected-learners 8 --require-bounded-window \
  --output "$ARTIFACT_ROOT/p07_lifecycle_report.json"
result=pass; exit_code=0
