#!/bin/bash
#PBS -N duraloco_p06c_red
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae
set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?}}"; PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?}" "${ARTIFACT_ROOT:?}" "${RUN_ID:?}" "${PARENT_RUN_ID:?}"
cd "$PROJECT_ROOT"; [[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]; [[ -z "$(git status --porcelain=v1)" ]]
mkdir -p "$ARTIFACT_ROOT"; touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"; export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
result=fail; exit_code=1
finish() { observed=$?; [[ "$result" == pass ]] && exit_code=0 || { [[ "$observed" -eq 0 ]] || exit_code=$observed; }; qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true; "$PYTHON_BIN" scripts/agent/create_run_manifest.py --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" --phase P06C --purpose unit --run-id "$RUN_ID" --parent-run-id "$PARENT_RUN_ID" --schema-version 2 --validation-shape p06c-schema-duplicate-policy-red-1node --backend memory --config scripts/miyabi/run_duraloco_p06c_red_1node.pbs --commands-log commands.log --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result" --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:10:00 --last-qstat-state R --termination-detail "P06C RED proves factor-two policy and duplicate decision behavior are initially absent" --stage-metrics-path red_report.json --assertion "factor-two ownership baseline passes" --assertion "six new policy/duplicate tests fail only at explicit P06C NotImplemented RED stubs" || true; }
trap finish EXIT; trap 'echo "[ERROR] P06C RED harness failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"; git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"; hostname | tee "$ARTIFACT_ROOT/hostname.log"; "$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"; module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
command=("$PYTHON_BIN" -m pytest -q tests/distributed_syncer/test_ownership_r2.py tests/distributed_syncer/test_hedged_execution.py tests/distributed_syncer/test_duplicate_equivalence.py); printf '%q ' "${command[@]}" | tee "$ARTIFACT_ROOT/commands.log"; printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
set +e; "${command[@]}" > "$ARTIFACT_ROOT/pytest_red.log" 2>&1; pytest_status=$?; set -e
cat "$ARTIFACT_ROOT/pytest_red.log" | tee -a "$ARTIFACT_ROOT/stdout.log"
[[ "$pytest_status" -ne 0 ]]; [[ "$(rg -c 'NotImplementedError: P06C RED' "$ARTIFACT_ROOT/pytest_red.log")" -eq 6 ]]; rg -q '6 failed, 1 passed' "$ARTIFACT_ROOT/pytest_red.log"
"$PYTHON_BIN" - "$ARTIFACT_ROOT/red_report.json" <<'PY'
import json,sys
json.dump({"status":"PASS","expected_red_failures":6,"passing_foundation_tests":1,"failure_kind":"explicit_NotImplementedError","unexpected_failures":0},open(sys.argv[1],"w"),indent=2,sort_keys=True)
PY
result=pass; exit_code=0
