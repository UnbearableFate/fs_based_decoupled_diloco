#!/bin/bash
#PBS -N duraloco_p06_check
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
CHECKOUT_ROOT="${CHECKOUT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$CHECKOUT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${PARENT_RUN_ID:?PARENT_RUN_ID is required}"
: "${MAKER_ONE:?MAKER_ONE is required}"
: "${MAKER_TWO:?MAKER_TWO is required}"
: "${MAKER_NINE:?MAKER_NINE is required}"

cd "$CHECKOUT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$CHECKOUT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$CHECKOUT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" \
    --phase P06 --purpose contract --run-id "$RUN_ID" --parent-run-id "$PARENT_RUN_ID" \
    --schema-version 2 --validation-shape p06-independent-checker-1node \
    --backend lustre --config scripts/miyabi/run_duraloco_p06_checker_1node.pbs \
    --commands-log commands.log --stdout stdout.log --stderr stderr.log \
    --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:10:00 \
    --last-qstat-state R --termination-detail "Independent P06 interval, publication, adoption, recovery, and terminal audit" \
    --assertion "all 20 P06 acceptance IDs and clean 1/2/9-node lineage were audited" \
    --assertion "Checker-only corrupt-request and mid-interval successor counterexample failed closed" \
    --assertion "single learner runtime and no-head-CAS surface were independently audited" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06 Checker failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
hostname | tee "$ARTIFACT_ROOT/hostname.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
}
run_command "$PYTHON_BIN" scripts/agent/check_research_contract.py --root "$CHECKOUT_ROOT"
run_command "$PYTHON_BIN" scripts/agent/check_phase_state.py plans/duraloco/STATE.yaml --root "$CHECKOUT_ROOT"
run_command bash -n scripts/miyabi/run_duraloco_p06_1node.pbs \
  scripts/miyabi/run_duraloco_p06_2node.pbs \
  scripts/miyabi/run_duraloco_p06_9node_gpt2_50x10.pbs \
  scripts/miyabi/run_duraloco_p06_checker_1node.pbs \
  scripts/chaos/run_p06_learner_restart.sh scripts/chaos/run_p06_terminal_learner_restart.sh
run_command "$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$CHECKOUT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"
printf '%q ' "$PYTHON_BIN" -m fs_diloco.testing.reference_cli --count 10000 --steps 12 | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"$PYTHON_BIN" -m fs_diloco.testing.reference_cli --count 10000 --steps 12 \
  | tee "$ARTIFACT_ROOT/reference_10000.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
run_command "$PYTHON_BIN" -m pytest -q tests --junitxml "$ARTIFACT_ROOT/junit.xml"
run_command "$PYTHON_BIN" scripts/agent/check_p06_final.py \
  --root "$CHECKOUT_ROOT" --artifact-root "$ARTIFACT_ROOT" \
  --maker-one "$MAKER_ONE" --maker-two "$MAKER_TWO" --maker-nine "$MAKER_NINE" \
  --output "$ARTIFACT_ROOT/checker_results.json" --report "$ARTIFACT_ROOT/checker_report.md"
result=pass
exit_code=0
