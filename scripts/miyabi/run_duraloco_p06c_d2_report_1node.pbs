#!/bin/bash
#PBS -N duraloco_p06c_d2rep
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${EXPECTED_SOURCE_COMMIT:?EXPECTED_SOURCE_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${PARENT_RUN_ID:?PARENT_RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${SOURCE_ARTIFACT_ROOT:?SOURCE_ARTIFACT_ROOT is required}"
: "${SOURCE_TRAINING_ROOT:?SOURCE_TRAINING_ROOT is required}"
: "${SOURCE_RUN_ID:?SOURCE_RUN_ID is required}"
cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" \
    --phase P06C --purpose analysis --run-id "$RUN_ID" --parent-run-id "$PARENT_RUN_ID" --schema-version 2 \
    --validation-shape p06c-d2-r2-preserved-authority-strict-reanalysis \
    --backend lustre --model-revision synthetic-tiny --dataset-revision synthetic-v1 \
    --config scripts/miyabi/run_duraloco_p06c_d2_report_1node.pbs --commands-log commands.log \
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo analysis_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:10:00 --last-qstat-state R \
    --termination-detail "Strict reanalysis of preserved successful D2-R2 runtime and old-epoch abandoned attempts" \
    --stage-metrics-path d2_r2_report.json \
    --assertion "source runtime commit and failed analysis manifest are preserved without mutation" \
    --assertion "committed attempt telemetry is complete and extra old-epoch attempts are classified as abandoned evidence" \
    --assertion "four transitions, three fencing epochs, executor/committer/whole-host recovery, and terminal stop pass"
}
trap finish EXIT
trap 'echo "[ERROR] P06C D2 report failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
"$PYTHON_BIN" - "$SOURCE_ARTIFACT_ROOT/manifest.json" "$EXPECTED_SOURCE_COMMIT" "$PARENT_RUN_ID" <<'PY'
import json,sys
manifest=json.load(open(sys.argv[1],encoding='utf-8'))
assert manifest['git_commit']==sys.argv[2]
assert manifest['run_id']==sys.argv[3]
assert manifest['result']=='fail' and manifest['termination_kind']=='test_failure'
PY
hostname | tee "$ARTIFACT_ROOT/hostname.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" scripts/agent/create_p06c_runtime_report.py --root "$SOURCE_TRAINING_ROOT" --run-id "$SOURCE_RUN_ID" --run-generation 1 --expected-mode active_active --expected-learners 2 --allow-degraded-attempts --output "$ARTIFACT_ROOT/d2_r2_runtime_report.json" | tee "$ARTIFACT_ROOT/stdout.log"
"$PYTHON_BIN" scripts/agent/create_p06c_d2_report.py --root "$SOURCE_TRAINING_ROOT" --base-report "$ARTIFACT_ROOT/d2_r2_runtime_report.json" --training-summary "$SOURCE_ARTIFACT_ROOT/training_summary.json" --output "$ARTIFACT_ROOT/d2_r2_report.json" | tee -a "$ARTIFACT_ROOT/stdout.log"
result=pass
exit_code=0
