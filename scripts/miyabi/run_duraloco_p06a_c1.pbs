#!/bin/bash
#PBS -N duraloco_p06a_c1
#PBS -q debug-g
#PBS -W group_list=xg24i002
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m ae

set -eEuo pipefail
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat WANDB_MODE=disabled

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
: "${EXPECTED_COMMIT:?EXPECTED_COMMIT is required}"
: "${RUN_ID:?RUN_ID is required}"
: "${ARTIFACT_ROOT:?ARTIFACT_ROOT is required}"
: "${STORAGE_ROOT:?STORAGE_ROOT is required}"
PARENT_RUN_ID="${PARENT_RUN_ID:-}"
CONFIG="$PROJECT_ROOT/configs/fs_diloco_gpt2_wikitext2_1l_debug.yaml"
TRAINING_ROOT="$STORAGE_ROOT/training"

cd "$PROJECT_ROOT"
mkdir -p "$ARTIFACT_ROOT" "$TRAINING_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
[[ "$(hostname)" == mg* ]]
[[ -n "${PBS_JOBID:-}" && -n "${PBS_NODEFILE:-}" ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  args=(
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json"
    --phase P06A --purpose contract --run-id "$RUN_ID" --schema-version 2
    --validation-shape p06a-c1-decomposed-crs-gpt2-wikitext2
    --backend lustre --model-revision gpt2 --dataset-revision wikitext-2-raw-v1
    --config scripts/miyabi/run_duraloco_p06a_c1.pbs --commands-log commands.log
    --stdout stdout.log --stderr stderr.log --exit-code "$exit_code" --result "$result"
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)"
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:30:00
    --last-qstat-state R --termination-detail "P06A full suite and decomposed CRS real GPT-2/WikiText-2 C1 path"
    --assertion "full dependency suite and active embedded-database scan pass"
    --assertion "decomposed CRS commits a paired parameter/outer-state transition through the existing fenced head CAS"
    --assertion "real GPT-2/WikiText-2 loss is finite and learner adoption remains boundary-only"
  )
  if [[ -n "$PARENT_RUN_ID" ]]; then args+=(--parent-run-id "$PARENT_RUN_ID"); fi
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py "${args[@]}" || true
}
trap finish EXIT
trap 'echo "[ERROR] P06A C1 gate failed at line $LINENO" | tee -a "$ARTIFACT_ROOT/stderr.log"' ERR

hostname | tee "$ARTIFACT_ROOT/hostname.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"
findmnt -T "$STORAGE_ROOT" > "$ARTIFACT_ROOT/mount.log" 2>&1 || true

run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2>&1 | tee -a "$ARTIFACT_ROOT/stdout.log"
}

run_command "$PYTHON_BIN" scripts/agent/check_phase_state.py plans/duraloco/STATE.yaml \
  --root "$PROJECT_ROOT"
run_command "$PYTHON_BIN" scripts/agent/check_no_embedded_database.py --root "$PROJECT_ROOT" \
  --output "$ARTIFACT_ROOT/forbidden_surface.json"
run_command "$PYTHON_BIN" -m fs_diloco.testing.reference_cli --count 1000 --steps 12
run_command "$PYTHON_BIN" -m pytest -q tests --junitxml "$ARTIFACT_ROOT/junit.xml"

CUDA_VISIBLE_DEVICES=0 "$PYTHON_BIN" -m fs_diloco.syncer \
  --config "$CONFIG" --run-id "$RUN_ID-training" --shared-root "$TRAINING_ROOT" \
  --num-learners 1 --owner-id syncer-a --owner-session-id "$RUN_ID-owner" \
  > "$ARTIFACT_ROOT/syncer.log" 2>&1 &
syncer_pid=$!
sleep 5
CUDA_VISIBLE_DEVICES=0 "$PYTHON_BIN" -m fs_diloco.learner \
  --config "$CONFIG" --run-id "$RUN_ID-training" --shared-root "$TRAINING_ROOT" \
  --learner-id learner_000 --num-learners 1 \
  > "$ARTIFACT_ROOT/learner.log" 2>&1 &
learner_pid=$!
wait "$learner_pid"
wait "$syncer_pid"
printf '%q ' "$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json \
  | tee -a "$ARTIFACT_ROOT/commands.log"
printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
"$PYTHON_BIN" -m fs_diloco.analysis summary "$TRAINING_ROOT" --json \
  | tee "$ARTIFACT_ROOT/training_summary.json" | tee -a "$ARTIFACT_ROOT/stdout.log"

"$PYTHON_BIN" - "$TRAINING_ROOT" "$ARTIFACT_ROOT" <<'PY' \
  | tee "$ARTIFACT_ROOT/c1_report.json"
import csv
import json
import math
from pathlib import Path
import sys

root, artifacts = map(Path, sys.argv[1:])
events = [json.loads(line) for line in (root / "logs" / "learner_000.jsonl").read_text().splitlines() if line.strip()]
syncer_events = [json.loads(line) for line in (root / "logs" / "syncer.jsonl").read_text().splitlines() if line.strip()]
metrics = list(csv.DictReader((root / "metrics" / "learner_metrics.csv").open()))
losses = [float(row["train_loss"]) for row in metrics if row.get("train_loss")]
assert losses and all(math.isfinite(value) for value in losses)
commits = [event for event in syncer_events if event.get("event_type") == "transition_committed"]
assert commits
assert all(event.get("selected_proposal_ids") for event in commits)
assert any(event.get("event_type") == "global_adopted" for event in events)
summary = json.loads((artifacts / "training_summary.json").read_text())
report = {
    "status": "PASS",
    "finite_losses": losses,
    "local_steps": max(int(row["local_step"]) for row in metrics),
    "optimizer_transitions": len(commits),
    "boundary_adoptions": sum(event.get("event_type") == "global_adopted" for event in events),
    "final_commit_id": commits[-1]["commit_id"],
    "summary_stop_reason": summary.get("stop_reason"),
}
assert report["local_steps"] <= 10
print(json.dumps(report, indent=2, sort_keys=True))
PY

result=pass
exit_code=0
