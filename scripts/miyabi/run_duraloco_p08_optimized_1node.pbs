#!/bin/bash
#PBS -N duraloco_p08_opt1
#PBS -q debug-g
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -W group_list=xg24i002
#PBS -j oe

set -eEuo pipefail
trap 'echo "[ERROR] line=$LINENO status=$?" >&2' ERR
export PAGER=cat MODULES_PAGER=cat LMOD_PAGER=cat CUDA_VISIBLE_DEVICES=""

: "${EXPECTED_COMMIT:?set EXPECTED_COMMIT to the clean P08 candidate commit}"
: "${RUN_ID:?set a unique P08 run ID}"
: "${ARTIFACT_ROOT:?set ARTIFACT_ROOT under artifacts/duraloco/P08}"
PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
RUFF_BIN="$PROJECT_ROOT/.venv/bin/ruff"
mkdir -p "$ARTIFACT_ROOT"
touch "$ARTIFACT_ROOT/stdout.log" "$ARTIFACT_ROOT/stderr.log" "$ARTIFACT_ROOT/commands.log"
cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

result=fail
exit_code=1
finish() {
  observed=$?
  if [[ "$result" == pass ]]; then exit_code=0; elif [[ "$observed" -ne 0 ]]; then exit_code=$observed; fi
  qstat "$PBS_JOBID" > "$ARTIFACT_ROOT/qstat_final.log" 2>&1 || true
  "$PYTHON_BIN" scripts/agent/create_run_manifest.py \
    --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/manifest.json" \
    --phase P08 --purpose contract --run-id "$RUN_ID" --schema-version 2 \
    --validation-shape p08-loops2-4-focused-optimized-1node \
    --backend lustre --config scripts/miyabi/run_duraloco_p08_optimized_1node.pbs \
    --commands-log commands.log --stdout stdout.log --stderr stderr.log \
    --exit-code "$exit_code" --result "$result" \
    --termination-kind "$([[ "$result" == pass ]] && echo success || echo test_failure)" \
    --pbs-queue debug-g --requested-resources select=1:mpiprocs=1,walltime=00:30:00 \
    --last-qstat-state R --termination-detail "P08 direct/streaming/cache/range/resume focused qualification" \
    --assertion "direct gather/scatter, single-copy learner payload and streaming numeric equivalence pass" \
    --assertion "validation reuse, cheap rejection, range integrity, lineage indexing and error resume pass" \
    --assertion "streaming hard working-set counters remain flat through quorum eight" || true
}
trap finish EXIT

[[ "$(hostname)" == mg* ]]
[[ "$(git rev-parse HEAD)" == "$EXPECTED_COMMIT" ]]
[[ -z "$(git status --porcelain=v1)" ]]
hostname | tee "$ARTIFACT_ROOT/hostname.log"
git status --short --branch | tee "$ARTIFACT_ROOT/git_status.log"
git rev-parse HEAD | tee "$ARTIFACT_ROOT/git_commit.log"
"$PYTHON_BIN" --version 2>&1 | tee "$ARTIFACT_ROOT/python_version.log"
module list 2>&1 | cat > "$ARTIFACT_ROOT/modules.log"

run_command() {
  printf '%q ' "$@" | tee -a "$ARTIFACT_ROOT/commands.log"
  printf '\n' | tee -a "$ARTIFACT_ROOT/commands.log"
  "$@" 2> >(tee -a "$ARTIFACT_ROOT/stderr.log" >&2) | tee -a "$ARTIFACT_ROOT/stdout.log"
}

run_command "$RUFF_BIN" check fs_diloco tests/performance_core
run_command "$PYTHON_BIN" scripts/agent/check_no_embedded_database.py \
  --root "$PROJECT_ROOT" --output "$ARTIFACT_ROOT/forbidden_surface.json"
run_command "$PYTHON_BIN" -m pytest -q \
  tests/performance_core \
  tests/storage/test_posix_contract.py \
  tests/test_proposal_catalog.py \
  tests/log/test_production_runtime.py \
  tests/coordination/test_production_fencing.py \
  tests/distributed_syncer/test_executor_prepare_only.py \
  tests/distributed_syncer/test_distributed_transition_binding.py \
  tests/learner_protocol/test_runtime_integration_contract.py \
  --junitxml "$ARTIFACT_ROOT/focused-junit.xml"
run_command "$PYTHON_BIN" -m benchmarks.bench_streaming_reduce \
  --output "$ARTIFACT_ROOT/lfe_streaming_optimized.json"
result=pass
exit_code=0
